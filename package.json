{
  "name": "n8n-nodes-camoufox",
  "version": "1.0.0",
  "description": "n8n node for Camoufox anti-detect browser automation via Playwright",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/LPilic/n8n-nodes-camoufox",
  "author": {
    "name": "LPilic",
    "email": "luka@pilic.work"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LPilic/n8n-nodes-camoufox.git"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && gulp build:icons",
    "dev": "tsc --watch",
    "test": "jest",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CamoufoxApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Camoufox/Camoufox.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "n8n-workflow": ">=1.62.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "playwright-core": "^1.40.0"
  }
}
